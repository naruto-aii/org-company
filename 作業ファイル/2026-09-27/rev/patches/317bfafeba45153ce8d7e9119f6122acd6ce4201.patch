 lib/models/strength_workout_log.dart          | 17 ++++++----
 .../settings/account_deletion_screen.dart     |  7 ++--
 lib/widgets/common/app_keyboard_dismiss.dart  | 33 ++++++++++---------
 test/account_deletion_screen_test.dart        |  4 +++
 test/app_keyboard_dismiss_test.dart           | 19 ++++++++---
 test/goal_pace_sync_regression_test.dart      |  1 +
 ...pabase_alcohol_entry_integration_test.dart |  3 ++
 ...se_food_entry_delete_integration_test.dart |  5 +++
 ...upabase_hardening_migration_live_test.dart |  3 ++
 test/supabase_migration_live_test.dart        |  2 ++
 ...aved_food_repository_integration_test.dart |  8 +++++
 12 files changed, 77 insertions(+), 31 deletions(-)
 create mode 100644 dart_test.yaml

diff --git a/dart_test.yaml b/dart_test.yaml
new file mode 100644
index 0000000..7e3a999
--- /dev/null
+++ b/dart_test.yaml
@@ -0,0 +1,6 @@
+# Live Supabase tests. Run them only when the local CLI is up:
+#   flutter test --tags integration
+# Skip them (the default suite still skips each test when port 54321 is closed):
+#   flutter test --exclude-tags integration
+tags:
+  integration:
diff --git a/lib/models/strength_workout_log.dart b/lib/models/strength_workout_log.dart
index 918853b..edef943 100644
--- a/lib/models/strength_workout_log.dart
+++ b/lib/models/strength_workout_log.dart
@@ -66,18 +66,24 @@ class StrengthWorkoutLog {
           }
           final first = exercise.sets.first;
           final same = exercise.sets.every(
-            (set) =>
-                set.weightKg == first.weightKg && set.reps == first.reps,
+            (set) => set.weightKg == first.weightKg && set.reps == first.reps,
           );
           final setLabel = '${exercise.sets.length}セット';
           if (same && first.weightKg != null && first.reps != null) {
-            return '${exercise.name} $setLabel ${first.weightKg}kg×${first.reps}';
+            return '${exercise.name} $setLabel ${_formatKg(first.weightKg!)}kg×${first.reps}';
           }
           return '${exercise.name} $setLabel';
         })
         .join(' · ');
   }
 
+  static String _formatKg(double value) {
+    if (value == value.roundToDouble()) {
+      return value.toStringAsFixed(0);
+    }
+    return value.toString();
+  }
+
   Map<String, Object?> toJson() => {
     'exercises': exercises.map((exercise) => exercise.toJson()).toList(),
   };
@@ -140,10 +146,7 @@ class StrengthNotesCodec {
       final decoded = jsonDecode(jsonText);
       if (decoded is Map<String, dynamic>) {
         final log = StrengthWorkoutLog.fromJson(decoded);
-        return StrengthNotesPayload(
-          log: log.isEmpty ? null : log,
-          memo: memo,
-        );
+        return StrengthNotesPayload(log: log.isEmpty ? null : log, memo: memo);
       }
     } catch (_) {}
     return StrengthNotesPayload(memo: memo.isEmpty ? text.trim() : memo);
