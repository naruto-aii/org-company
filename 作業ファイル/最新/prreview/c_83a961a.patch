+  @override
+  bool get isPlusActive => false;
+
+  @override
+  Stream<bool> get plusChanges => const Stream.empty();
+
+  @override
+  Future<void> restore() async {}
+
+  @override
+  Future<void> purchaseMonthly() {
+    throw SubscriptionPurchaseUnavailableException();
+  }
+
+  @override
