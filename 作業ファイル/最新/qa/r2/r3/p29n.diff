+});
+
+Deno.test("store keeps the refresh token on the server", async () => {
+  const calls: Call[] = [];
+  const deps = storeDepsFrom(platformEnv(), fakeFetch(calls, {
+    appleStatus: 200,
+    appleBody: { refresh_token: refreshToken, access_token: "access-token-value" },
