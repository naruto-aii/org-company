+
+Deno.test("missing apple secrets do not block account deletion", async () => {
+  const calls: Call[] = [];
+  const env = platformEnv();
+  delete (env as { APPLE_PRIVATE_KEY?: string }).APPLE_PRIVATE_KEY;
+  const deps = deleteDepsFrom(env, fakeFetch(calls, {}));
