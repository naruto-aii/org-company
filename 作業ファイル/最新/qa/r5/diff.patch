+function header(init: RequestInit | undefined, name: string): string {
+  const headers = init?.headers;
+  if (!headers || headers instanceof Headers || Array.isArray(headers)) {
+    return "";
+  }
+  const record = headers as Record<string, string>;
+  return record[name] ?? "";
