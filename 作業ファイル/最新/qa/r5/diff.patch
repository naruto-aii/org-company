+      expect(production.contains('BEGIN EC PRIVATE KEY'), isFalse);
+      expect(
+        RegExp(
+          'BEGIN PRIVATE KEY-----[\\r\\n]+[A-Za-z0-9+/=]',
+        ).hasMatch(production),
