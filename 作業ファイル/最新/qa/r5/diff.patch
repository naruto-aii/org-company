+const keyPair = await crypto.subtle.generateKey(
+  { name: "ECDSA", namedCurve: "P-256" },
+  true,
+  ["sign", "verify"],
+);
+const pem = derToPem(await crypto.subtle.exportKey("pkcs8", keyPair.privateKey));
