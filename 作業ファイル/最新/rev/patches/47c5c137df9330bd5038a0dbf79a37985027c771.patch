+
+void main() {
+  group('StrengthNotesCodec', () {
+    test('roundtrips multiple exercises and sets with memo', () {
+      const log = StrengthWorkoutLog(
+        exercises: [
+          StrengthExerciseLog(
+            name: 'ベンチプレス',
+            sets: [
+              StrengthSetLog(weightKg: 60, reps: 10),
+              StrengthSetLog(weightKg: 62.5, reps: 8),
